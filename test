Prerequisites
# Tools needed
terraform >= 1.5
ansible >= 2.14
kubectl >= 1.28
docker >= 24
python 3.11+
gh CLI (for CI/CD secrets)
Phase 1: Terraform — Provision VMs
cd terraform

# 1. Initialize
terraform init

# 2. Review plan (check vm_count, network_cidr, ssh_public_key)
terraform plan -var-file="terraform.tfvars"

# 3. Apply (provisions master + worker VMs via libvirt)
terraform apply -var-file="terraform.tfvars" -auto-approve

# 4. Verify VMs exist
virsh list --all

# 5. Get IPs for Ansible inventory
terraform output -json > ../ansible/inventory.json
Verify:
- terraform output shows master/worker IPs
- virsh console <vm> → login works with your SSH key
Phase 2: Ansible — Configure K8s + Docker
cd ../ansible

# 1. Install collections
ansible-galaxy collection install -r requirements.yml

# 2. Generate inventory from terraform output (or edit hosts.ini manually)
# Example hosts.ini:
# [masters]
# master1 ansible_host=192.168.122.10 ansible_user=devops
# [workers]
# worker1 ansible_host=192.168.122.11 ansible_user=devops
# worker2 ansible_host=192.168.122.12 ansible_user=devops

# 3. Run full playbook (docker → k8s_common → master → workers)
ansible-playbook -i hosts.ini playbook.yml

# 4. Verify cluster
ssh devops@<master-ip> "kubectl get nodes -o wide"
Verify each phase:
# Docker + containerd
ansible all -i hosts.ini -m shell -a "docker version && containerd --version"

# K8s components
ansible all -i hosts.ini -m shell -a "kubelet --version && kubeadm version"

# Cluster ready
ssh devops@<master-ip> "kubectl get nodes -o wide; kubectl get pods -A"
Phase 3: Build & Test Microservices Locally
cd ../app

# 1. Install shared package + deps
pip install -e shared/
for svc in users-service products-service orders-service; do
  pip install -r $svc/requirements.txt
done

# 2. Run lint
pip install ruff==0.1.9
ruff check shared/
for svc in users-service products-service orders-service; do
  ruff check $svc/
done

# 3. Run smoke tests (import test + basic pytest)
ENVIRONMENT=dev LOG_FORMAT=plain VAULT_ADDR="" pytest -q . || true
for svc in users-service products-service orders-service; do
  (cd $svc && PYTHONPATH=../shared:. ENVIRONMENT=dev python -c "import main; print('$svc import OK')")
done

# 4. Build Docker images locally (context = app/)
for svc in users-service products-service orders-service; do
  docker build -t $svc:local -f $svc/Dockerfile .
done

# 5. Test containers locally
docker run --rm -p 8001:8000 -e ENVIRONMENT=dev -e VAULT_ADDR="" users-service:local &
curl http://localhost:8001/health  # or /livez /readyz
Expected endpoints per service:
- GET /livez — liveness (always OK)
- GET /readyz — readiness (checks Vault connectivity)
- GET /health — app health
- GET /metrics — Prometheus metrics
Phase 4: Deploy to Kubernetes
cd ../k8s

# 1. Namespace + quotas + limits
kubectl apply -f apps/namespace.yaml

# 2. Vault (dev mode for dev env)
kubectl apply -f vault/manifests.yaml
kubectl rollout status deploy/vault -n vault --timeout=120s

# 3. Bootstrap Vault root token Secret (dev only)
../scripts/bootstrap-vault-secret.sh

# 4. Deploy microservices + RBAC + HPA + NetworkPolicies + PDBs
kubectl apply -f apps/

# 5. Verify rollouts
kubectl rollout status -n devops-platform deploy/users-service --timeout=120s
kubectl rollout status -n devops-platform deploy/products-service --timeout=120s
kubectl rollout status -n devops-platform deploy/orders-service --timeout=120s

# 6. Test endpoints
kubectl port-forward -n devops-platform svc/users-service 8001:80 &
curl http://localhost:8001/readyz
curl http://localhost:8001/health
Phase 5: Security Validation (Local)
# Run all security checks (matches CI)
../scripts/validate-security.sh --ci

# Individual checks:
# 1. Gitleaks
gitleaks detect --source .. --config .gitleaks.toml -v

# 2. Trivy image scan
for svc in users-service products-service orders-service; do
  trivy image --severity CRITICAL,HIGH $svc:local
done

# 3. Kubeconform (manifest schema validation)
kubeconform -strict -kubernetes-version 1.28.0 k8s/

# 4. yamllint
yamllint -d "{rules: {line-length: disable}}" k8s/
Phase 6: CI/CD Pipeline (GitHub Actions)
Required GitHub Repository Secrets
Secret	Value
KUBECONFIG	base64 -w0 < ~/.kube/config
GITHUB_TOKEN	Auto-provided
GHCR_TOKEN	ghp_... (if not using built-in GITHUB_TOKEN)
Required GitHub Environments
- production → protected, required reviewers
Trigger Pipeline
# Push to main/develop triggers lint → gitleaks → semgrep → test → build → trivy
git push origin main

# Manual deploy (workflow_dispatch + production environment approval)
gh workflow run ci-cd.yml --ref main
# Or via GitHub UI: Actions → CI/CD Pipeline → Run workflow → Deploy
Pipeline Stages (from .github/workflows/ci-cd.yml)
Stage	Job	Blocks On
1	lint (ruff, terraform fmt, yamllint, kubeconform)	—
2	gitleaks (secret scan)	—
3	semgrep (SAST, SARIF upload)	—
4	test (pip-audit, import smoke test, docker build test)	lint, gitleaks, semgrep
5	build (matrix: 3 services, push to ghcr.io, SBOM)	test
6	trivy-scan (scan @digest, SARIF + SBOM upload)	build
7	terraform-validate	lint, gitleaks
8	deploy (manual, workflow_dispatch, production env)	trivy-scan, terraform-validate
Phase 7: Verify Full Stack
# 1. Check all pods running
kubectl get pods -n devops-platform -o wide
kubectl get pods -n vault -o wide

# 2. Test service-to-service (orders → products → users)
kubectl exec -n devops-platform deploy/orders-service -- \
  curl -s http://products-service:80/health
kubectl exec -n devops-platform deploy/products-service -- \
  curl -s http://users-service:80/health

# 3. Check Vault integration
kubectl exec -n devops-platform deploy/users-service -- \
  cat /vault/secrets/db-password  # should show secret, not empty

# 4. Check metrics
kubectl port-forward -n monitoring svc/prometheus 9090:9090 &
curl 'http://localhost:9090/api/v1/query?query=up{job="users-service"}'

# 5. Check logs (ELK if deployed)
kubectl logs -n devops-platform -l app=users-service --tail=20
