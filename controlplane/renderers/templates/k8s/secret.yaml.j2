{# Per-deployment secret. Values come from the secret store at render time and
   are never read back out of the platform's own API. #}
apiVersion: v1
kind: Secret
metadata:
  name: {{ name }}-env
  namespace: {{ namespace }}
  labels:
    app: {{ name }}
type: Opaque
stringData:
{% for key, value in secrets.items() %}
  {{ key }}: {{ value | tojson }}
{% endfor %}
