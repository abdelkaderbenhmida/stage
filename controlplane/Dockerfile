# Control-plane image (API + Celery worker share it).
#
# Build context is the REPOSITORY ROOT, so that `controlplane` stays an
# importable package and the Terraform/Ansible assets it renders from remain
# reachable:  docker build -f controlplane/Dockerfile .
#
# External tools (terraform, ansible, trivy, gitleaks, kubectl) are NOT
# installed here — runners/sandbox.py executes each one inside its own
# ephemeral container (PLATFORM_SPEC §7.2). Only the docker CLI is needed, to
# talk to the mounted socket.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends docker.io curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r platform && useradd -r -g platform platform --home-dir /app --no-create-home

WORKDIR /app

COPY controlplane/requirements.txt controlplane/requirements.txt
COPY controlplane/requirements-hashed.txt controlplane/requirements-hashed.txt
# Hash-pinned install (§7 item 9): the lock was generated by
# scripts/hash-requirements.py and verified to resolve offline.
RUN pip install --no-cache-dir --require-hashes -r controlplane/requirements-hashed.txt

COPY controlplane/ controlplane/
COPY ansible/ ansible/
COPY terraform/ terraform/

# Workspaces hold rendered Terraform/Ansible artifacts and per-project state.
RUN mkdir -p /var/lib/controlplane/workspaces \
    && chown -R platform:platform /var/lib/controlplane /app

USER platform

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/healthz || exit 1

CMD ["uvicorn", "controlplane.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
