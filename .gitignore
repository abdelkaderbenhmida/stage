# Repo-wide ignore rules. The most security-relevant entry is
# terraform.tfstate — see devops-analysis-report.md P0 #4: a previous commit
# tracked a state file containing a cleartext SSH public key.

# Terraform state (NEVER commit)
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/.terraform/terraform.tfstate
**/*.tfstate
**/*.tfstate.backup
*.tfvars
!terraform/terraform.tfvars.example
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json
.terraform/
**/.terraform/
destroy_*
crash.log
terraform/inventory.generated.ini
terraform/plan.out
crash.*.log

# Ansible
ansible/inventory.ini
ansible/*.retry
ansible/retries/
ansible/.vault-pass
ansible/.vault_pass

# Python / tooling caches
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/.venv/
**/venv/
**/dist/
**/build/
*.egg-info/
**/*.egg-info/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Reports / generated artifacts — regenerated, not versioned
autopilot.log
vigolium-report.html
semgrep-findings-report.md
findings.md
RAPPORT_*.md
trivy-*.json
sbom-*.json

# Local env files
.env
.envrc
.env.*
!.env.example

# Orphan test/debug files
aa
tt
test

# Helm archives
helm-*.tar.gz
graphify-out/
files.md/
.opencode/
# Archived working files — kept locally but not versioned
archive/

# k6 load test outputs
tests/k6/*.json
tests/k6/*.html

# Ansible Molecule
ansible/molecule/
ansible/.molecule/
