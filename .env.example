# ── DevOps Central Platform — env template ───────────────────────────────
# Copy to .env and fill values. .env is git-ignored and must NOT be committed.
#
# Secrets normally come from Vault at runtime. Override via env for local dev
# (when Vault is not running) — set ENVIRONMENT=dev to opt into dev fallbacks.
# ──────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────
ENVIRONMENT=dev                                   # dev|development|local → enables dev fallbacks
SERVICE_NAME=users-service                        # any discovered service dir under app/
LOG_LEVEL=DEBUG                                   # DEBUG|INFO|WARNING|ERROR
LOG_FORMAT=plain                                  # json (production) | plain (local dev)

# ── Vault ─────────────────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200                  # K8s: http://vault-service.vault.svc.cluster.local:8200
VAULT_TOKEN=                                      # Vault root token (dev mode); production uses K8s auth
# VAULT_DEV_ROOT_TOKEN_ID=                        # Alias for VAULT_TOKEN in legacy Vault dev mode

# ── users-service secrets ────────────────────────────────────────────────
DATABASE_URL=                                     # postgresql://user:pass@host:5432/usersdb
JWT_SECRET_KEY=                                   # Production: from Vault. Dev: auto-generated.

# ── products-service secrets ─────────────────────────────────────────────
API_KEY=

# ── orders-service secrets ───────────────────────────────────────────────
PAYMENT_GATEWAY_KEY=

# ── Ansible ───────────────────────────────────────────────────────────────
# ansible-vault encrypt with your own password; .vault-pass is git-ignored.
# ANSIBLE_VAULT_PASSWORD_FILE=.vault-pass