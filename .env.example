# ── DevOps Central Platform — env template ───────────────────────────────
# Copy to .env (git-ignored) and fill values, then run:
#
#     scripts/render-env.sh
#
# The render script rewrites every tracked file that embeds these values
# (ArgoCD repoURLs, GHCR registry, kubelet scrape IPs, ssh user, terraform
# defaults) using __TOKEN__ placeholders, so no personal identifier needs to
# be hardcoded in the tree.
#
# Secrets normally come from Vault at runtime. Override via env for local dev
# (when Vault is not running) — set ENVIRONMENT=dev to opt into dev fallbacks.
# ──────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────
ENVIRONMENT=dev                                   # dev|development|local → enables dev fallbacks
SERVICE_NAME=users-service                        # any discovered service dir under app/
LOG_LEVEL=DEBUG                                   # DEBUG|INFO|WARNING|ERROR
LOG_FORMAT=plain                                  # json (production) | plain (local dev)

# ── Vault ─────────────────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200                  # K8s: http://vault-service.vault.svc.cluster.local:8200
VAULT_TOKEN=                                      # Vault root token (dev mode); production uses K8s auth

# ── GitHub (personal) ─────────────────────────────────────────────────────
GITHUB_OWNER=your-github-username                 # → https://github.com/<owner>/<repo>.git, ghcr.io/<owner>
GITHUB_REPO=stage
# GHCR_PAT=                                       # fine-grained PAT, Packages:Read for <owner>/<repo> only.
#                                                # Used by scripts/bootstrap-ghcr-pull.sh to create the
#                                                # ghcr-pull k8s Secret (never printed, never committed).

# ── Cluster topology (personal) ───────────────────────────────────────────
K8S_MASTER_NAME=master-01                         # first control-plane node name
MASTER_IP=192.168.56.10                           # control-plane address on the libvirt NAT network
WORKER1_IP=192.168.56.11
WORKER2_IP=192.168.56.12
NETWORK_CIDR=192.168.56.0/24                      # libvirt network; .1 is the gateway, .10+ are the nodes

# ── libvirt / KVM (personal) ──────────────────────────────────────────────
LIBVIRT_URI=qemu:///system                        # local hypervisor; qemu+ssh://user@host/system for a remote one
STORAGE_POOL=default                              # virsh pool-list
BASE_IMAGE_PATH=/var/lib/libvirt/images/ubuntu-22.04-server-cloudimg-amd64.img
NETWORK_INTERFACE=enp1s0                          # NIC name inside the guest, used by cloud-init
DNS_SERVERS=1.1.1.1,8.8.8.8
# Ownership of volumes created in the pool — must match the qemu user on this
# host, or libvirt cannot open the disks it just made (`id qemu`).
LIBVIRT_VOLUME_OWNER_UID=64055
LIBVIRT_VOLUME_GROUP_GID=993
# Auth: the local libvirt socket. Your user must be in the `libvirt` group.
# No cloud credential lives here or in state.

# ── SSH (personal) ────────────────────────────────────────────────────────
SSH_USER=devops                                   # user Terraform/Ansible/kubectl reach nodes as

# ── users-service secrets ─────────────────────────────────────────────────
DATABASE_URL=                                     # postgresql://user:pass@host:5432/usersdb
JWT_SECRET_KEY=                                   # Production: from Vault. Dev: auto-generated.

# ── products-service secrets ──────────────────────────────────────────────
API_KEY=

# ── orders-service secrets ────────────────────────────────────────────────
PAYMENT_GATEWAY_KEY=

# ── Ansible ───────────────────────────────────────────────────────────────
# ansible-vault encrypt with your own password; .vault-pass is git-ignored.
# ANSIBLE_VAULT_PASSWORD_FILE=.vault-pass

# ── Control plane: cluster + observability ────────────────────────────────
# Everything below has a working default in controlplane/core/config.py —
# set them only where this environment differs from that default.
# CLUSTER_DOMAIN=devops.local                     # DNS suffix for tenant live URLs and ingress hosts
# KUBECONFIG_PATH=/kube/config                    # kubeconfig the worker mounts into kubectl sandboxes
# PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090   # per-project metrics panel
# LOKI_URL=http://loki.monitoring.svc.cluster.local:3100               # per-project logs panel
# ELASTICSEARCH_URL=http://elasticsearch.monitoring.svc.cluster.local:9200  # filebeat output in tenant namespaces

# ── Control plane: image registry ─────────────────────────────────────────
# REGISTRY=localhost:5000                         # where the control plane pushes built tenant images
# REGISTRY_INTERNAL=kind-registry:5000            # same registry as addressed from inside the cluster
# REGISTRY_NETWORK=kind                           # docker network the sandbox joins to reach it
# REGISTRY_INSECURE=true                          # plain HTTP registry (local dev only)
# REGISTRY_USER=
# REGISTRY_PASSWORD=                              # production: from Vault, never committed

# ── Control plane: build + scan sandbox ───────────────────────────────────
# SANDBOX_IMAGE=platform/sandbox:latest
# SANDBOX_CPUS=2
# SANDBOX_MEMORY_MB=1024
# PROVISION_TIMEOUT_SECONDS=900
# SCAN_TIMEOUT_SECONDS=300                        # raise on a slow link: Trivy's first DB pull is ~1GB
# TRIVY_CACHE_VOLUME=controlplane-trivy-cache     # named volume keeping that DB across --rm containers

# ── Control plane: auto-generated Dockerfile ──────────────────────────────
# Used only for a tenant repository that ships no Dockerfile of its own.
# The base image and its pinned upgrades live here, not in code, because
# they are what has to move when a new CVE lands — the pre-deploy Trivy gate
# blocks on HIGH, so a stale base image here blocks every auto-built deploy.
# AUTOBUILD_BASE_IMAGE=python:3.11-slim
# AUTOBUILD_PIP_HARDENING=wheel>=0.46.2 jaraco.context>=6.1.0 setuptools>=84
# AUTOBUILD_SERVER_PACKAGE=uvicorn[standard]>=0.24.0
# AUTOBUILD_RUN_UID=10001                         # must sit inside the cluster's PodSecurity uid range

# ── GitOps (optional) ─────────────────────────────────────────────────────
# Reconcile tenant workloads with ArgoCD instead of applying them once.
# Needs k8s/gitops/ deployed. Two addresses for ONE repository, same split as
# REGISTRY / REGISTRY_INTERNAL: the worker pushes from a sandbox on the host's
# docker network (NodePort), ArgoCD reads from inside the cluster (ClusterIP).
GITOPS_ENABLED=false
# GITOPS_REPO_URL=http://127.0.0.1:30300/controlplane/tenants.git
# GITOPS_REPO_URL_INTERNAL=http://git-server.gitops.svc.cluster.local:3000/controlplane/tenants.git
# GITOPS_USERNAME=controlplane
# GITOPS_PASSWORD=        # must match the git-server-admin Secret
# GITOPS_BRANCH=main

# ── Tekton (optional) ─────────────────────────────────────────────────────
# Run tenant builds as Pods in the tenant's own namespace instead of in a
# sandbox container on this host. Needs Tekton installed and the per-namespace
# Pipeline applied — see k8s/tekton/README.md. Repositories deployed this way
# need a real Dockerfile: .platform.yml stages and Dockerfile autogeneration
# both read a host checkout, which this path does not produce.
TEKTON_ENABLED=false
# TEKTON_TIMEOUT=30m

# ── Elasticsearch / Kibana (optional) ─────────────────────────────────────
# Per-tenant log access. Each team gets an Elasticsearch role, user and Kibana
# space; tenancy is enforced by index pattern (tenant-<namespace>-*) because
# index privileges are the only enforcement the basic licence offers.
# ELASTICSEARCH_URL=http://elasticsearch.monitoring.svc.cluster.local:9200
# KIBANA_URL=http://kibana.monitoring.svc.cluster.local:5601
# ELASTICSEARCH_USER=elastic
# ELASTICSEARCH_PASSWORD=
