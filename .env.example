# ── DevOps Central Platform — env template ───────────────────────────────
# Copy to .env (git-ignored) and fill values, then run:
#
#     scripts/render-env.sh
#
# The render script rewrites every tracked file that embeds these values
# (ArgoCD repoURLs, GHCR registry, kubelet scrape IPs, ssh user, terraform
# defaults) using __TOKEN__ placeholders, so no personal identifier needs to
# be hardcoded in the tree.
#
# Secrets normally come from Vault at runtime. Override via env for local dev
# (when Vault is not running) — set ENVIRONMENT=dev to opt into dev fallbacks.
# ──────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────
ENVIRONMENT=dev                                   # dev|development|local → enables dev fallbacks
SERVICE_NAME=users-service                        # any discovered service dir under app/
LOG_LEVEL=DEBUG                                   # DEBUG|INFO|WARNING|ERROR
LOG_FORMAT=plain                                  # json (production) | plain (local dev)

# ── Vault ─────────────────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200                  # K8s: http://vault-service.vault.svc.cluster.local:8200
VAULT_TOKEN=                                      # Vault root token (dev mode); production uses K8s auth

# ── GitHub (personal) ─────────────────────────────────────────────────────
GITHUB_OWNER=your-github-username                 # → https://github.com/<owner>/<repo>.git, ghcr.io/<owner>
GITHUB_REPO=stage
# GHCR_PAT=                                       # fine-grained PAT, Packages:Read for <owner>/<repo> only.
#                                                # Used by scripts/bootstrap-ghcr-pull.sh to create the
#                                                # ghcr-pull k8s Secret (never printed, never committed).

# ── Cluster topology (personal) ───────────────────────────────────────────
K8S_MASTER_NAME=master-01                         # first control-plane node name
MASTER_IP=192.168.56.10                           # control-plane address on the libvirt NAT network
WORKER1_IP=192.168.56.11
WORKER2_IP=192.168.56.12
NETWORK_CIDR=192.168.56.0/24                      # libvirt network; .1 is the gateway, .10+ are the nodes

# ── libvirt / KVM (personal) ──────────────────────────────────────────────
LIBVIRT_URI=qemu:///system                        # local hypervisor; qemu+ssh://user@host/system for a remote one
STORAGE_POOL=default                              # virsh pool-list
BASE_IMAGE_PATH=/var/lib/libvirt/images/ubuntu-22.04-server-cloudimg-amd64.img
NETWORK_INTERFACE=enp1s0                          # NIC name inside the guest, used by cloud-init
DNS_SERVERS=1.1.1.1,8.8.8.8
# Ownership of volumes created in the pool — must match the qemu user on this
# host, or libvirt cannot open the disks it just made (`id qemu`).
LIBVIRT_VOLUME_OWNER_UID=64055
LIBVIRT_VOLUME_GROUP_GID=993
# Auth: the local libvirt socket. Your user must be in the `libvirt` group.
# No cloud credential lives here or in state.

# ── SSH (personal) ────────────────────────────────────────────────────────
SSH_USER=devops                                   # user Terraform/Ansible/kubectl reach nodes as

# ── users-service secrets ─────────────────────────────────────────────────
DATABASE_URL=                                     # postgresql://user:pass@host:5432/usersdb
JWT_SECRET_KEY=                                   # Production: from Vault. Dev: auto-generated.

# ── products-service secrets ──────────────────────────────────────────────
API_KEY=

# ── orders-service secrets ────────────────────────────────────────────────
PAYMENT_GATEWAY_KEY=

# ── Ansible ───────────────────────────────────────────────────────────────
# ansible-vault encrypt with your own password; .vault-pass is git-ignored.
# ANSIBLE_VAULT_PASSWORD_FILE=.vault-pass